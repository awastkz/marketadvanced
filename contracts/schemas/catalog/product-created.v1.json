{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog/product-created.v1.json",
  "title": "ProductCreatedV1",
  "description": "В каталоге создан товар вместе с вариантами",
  "allOf": [{ "$ref": "../common/event-meta.json" }],
  "type": "object",
  "required": ["productId", "name", "slug", "categoryId", "isActive", "variants"],
  "properties": {
    "productId":  { "type": "string", "format": "uuid" },
    "name":       { "type": "string" },
    "slug":       { "type": "string" },
    "categoryId": { "type": "string", "format": "uuid" },
    "brandId":    { "type": ["string", "null"], "format": "uuid" },
    "isActive":   { "type": "boolean" },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["variantId", "sku", "price", "isActive"],
        "properties": {
          "variantId": { "type": "string", "format": "uuid" },
          "sku":       { "type": "string" },
          "name":      { "type": ["string", "null"] },
          "price":     { "type": "integer", "description": "Цена в тиынах" },
          "isActive":  { "type": "boolean" }
        }
      }
    }
  }
}
