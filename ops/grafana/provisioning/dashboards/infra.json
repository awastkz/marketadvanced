{
  "uid": "ma-infra",
  "title": "MarketAdvanced: нагрузка и ресурсы",
  "tags": [
    "marketadvanced"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "k6: что мы подаём",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "k6: виртуальные пользователи и запросов/с",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(k6_vus)",
          "legendFormat": "VUs"
        },
        {
          "refId": "B",
          "expr": "sum(rate(k6_http_reqs_total{name=\"products-list\"}[30s]))",
          "legendFormat": "req/s k6"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95: k6 против сервера",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(k6_http_req_duration_p95{name=\"products-list\"}) * 1000",
          "legendFormat": "p95 k6"
        },
        {
          "refId": "B",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"catalog\",http_route=\"api/admin/Products\"}[1m])))",
          "legendFormat": "p95 catalog"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Контейнеры: CPU и память",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "CPU по контейнеру, ядра",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{svc}}",
          "expr": "label_replace(sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"marketadvanced-(app|identity|catalog|cart|order|payment|gateway|postgres|redis|rabbitmq)-1\"}[1m])), \"svc\", \"$1\", \"name\", \"marketadvanced-(.*)-1\")"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Память по контейнеру",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{svc}}",
          "expr": "label_replace(max by (name) (container_memory_working_set_bytes{name=~\"marketadvanced-(app|identity|catalog|cart|order|payment|gateway|postgres|redis|rabbitmq)-1\"}), \"svc\", \"$1\", \"name\", \"marketadvanced-(.*)-1\")"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": ".NET runtime: потоки и GC",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Очередь пула потоков (если растёт — запросы ждут поток)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dotnet_thread_pool_queue_length_total",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Потоков в пуле",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dotnet_thread_pool_thread_count_total",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Куча после последней сборки GC (утечка = рост без возврата)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (dotnet_gc_last_collection_heap_size_bytes)",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "Postgres",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Активные соединения по состоянию",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (pg_stat_activity_count{datname=\"marketadvanced\"})",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Транзакций в секунду",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_xact_commit{datname=\"marketadvanced\"}[1m])",
          "legendFormat": "commit"
        },
        {
          "refId": "B",
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"marketadvanced\"}[1m])",
          "legendFormat": "rollback"
        }
      ]
    }
  ]
}