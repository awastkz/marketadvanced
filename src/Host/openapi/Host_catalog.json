              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "default": 0,
              "$ref": "#/components/schemas/PublicProductSort"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 24
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/PagedOfPublicProductCard"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedOfPublicProductCard"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedOfPublicProductCard"
                }
              }
            }
          }
        }
      }
    },
